# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Postgres for cases and paused graphs. Empty locally: uses PGlite in .data and in-memory checkpoints.
DATABASE_URL=

# Optional. Defaults to project 7's public server and its public demo token, which only reach fake data.
MCP_URL=
MCP_TOKEN=

# Optional. New cases per day across all visitors, to protect the free model quota. Default: 12.
DAILY_CASE_LIMIT=
